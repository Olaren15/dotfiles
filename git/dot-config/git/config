[user]
    name = Olaren
    email = git@olaren.dev

[commit]
    gpgsign = true

[tag]
    forceSignAnnotated = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = /home/olaren/.config/git/allowed-signers
    defaultKeyCommand = /home/olaren/.local/bin/git-signing-key

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true

[color]
    ui = auto

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true
    side-by-side = true
    syntax-theme = gruvbox-dark

[merge]
    conflictstyle = zdiff3
    tool = nvim

[mergetool "nvim"]
    cmd = nvim -d -c "wincmd l" -c "norm ]c" "$LOCAL" "$MERGED" "$REMOTE"

